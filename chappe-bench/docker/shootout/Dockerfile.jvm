# syntax=docker/dockerfile:1.7
#
# Image JVM unifiée pour les serveurs OOP du shootout (Chappe/Jetty/Helidon/JDK/Netty/Vert.x).
# Une seule image, six containers — chaque service du docker-compose choisit sa main class.
#
# Stage 1 : build Maven (chappe-bench + ses deps) — réutilise le cache /root/.m2
# Stage 2 : run JDK 25 avec classes + deps copiées
#
# The build uses the repo's own Maven wrapper (pinned 3.9.x) instead of a
# `maven:` base image, so the container toolchain cannot drift from the
# workspace one (a maven:4.0.0-rc-5 image broke on class file major 69).
ARG JDK_TAG=25-jdk-noble

FROM eclipse-temurin:${JDK_TAG} AS build
WORKDIR /chappe

COPY .mvn  .mvn
COPY mvnw  ./

# central-snapshots repo: needed to resolve the io.vidocq:vidocq-parent SNAPSHOT
COPY chappe-bench/docker/shootout/maven-settings.xml /tmp/maven-settings.xml

COPY pom.xml ./
COPY chappe-api/pom.xml                         chappe-api/pom.xml
COPY chappe-http/pom.xml                        chappe-http/pom.xml
COPY chappe-core/pom.xml                        chappe-core/pom.xml
COPY chappe-tests/pom.xml                       chappe-tests/pom.xml
COPY chappe-bench/pom.xml                       chappe-bench/pom.xml
COPY chappe-conformance/pom.xml                 chappe-conformance/pom.xml
COPY chappe-examples/pom.xml                    chappe-examples/pom.xml
COPY chappe-cli/pom.xml                         chappe-cli/pom.xml
COPY chappe-static-index-maven-plugin/pom.xml   chappe-static-index-maven-plugin/pom.xml

RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -s /tmp/maven-settings.xml -pl chappe-bench -am -DskipTests dependency:go-offline -B || true

COPY chappe-api/src                        chappe-api/src
COPY chappe-http/src                       chappe-http/src
COPY chappe-core/src                       chappe-core/src
COPY chappe-bench/src                      chappe-bench/src
COPY chappe-static-index-maven-plugin/src  chappe-static-index-maven-plugin/src

RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -s /tmp/maven-settings.xml -pl chappe-bench -am -DskipTests package \
    && ./mvnw -s /tmp/maven-settings.xml -pl chappe-bench -DskipTests -DincludeScope=runtime \
         dependency:copy-dependencies \
         -DoutputDirectory=/chappe/chappe-bench/target/dependency


FROM eclipse-temurin:${JDK_TAG} AS run
WORKDIR /chappe

COPY --from=build /chappe/chappe-bench/target/classes     /chappe/classes
COPY --from=build /chappe/chappe-bench/target/dependency  /chappe/deps

ENV PORT=8080
ENV JAVA_OPTS=""
EXPOSE 8080

# La main class est passée via le `command` du docker-compose ($1).
# Exemple : command: ["io.vidocq.chappe.bench.oop.ChappeMain"]
# JAVA_OPTS (word-split intended): extra flags for diagnostics — JFR, pollers, GC.
ENTRYPOINT ["sh", "-c", "exec java --enable-preview $JAVA_OPTS -cp \"/chappe/classes:/chappe/deps/*\" \"$1\"", "--"]

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the shootout Docker builds.

  Since the migration to the shared `io.vidocq:vidocq-parent` POM, the chappe
  reactor needs the Central *snapshots* repository to resolve the parent
  (SNAPSHOTs are not served by repo.maven.apache.org).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>central-snapshots</id>
      <repositories>
        <repository>
          <id>central-snapshots</id>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-snapshots</activeProfile>
  </activeProfiles>
</settings>

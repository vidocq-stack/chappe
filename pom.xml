    <properties>
        <!-- Quality -->
        <spotless.version>2.46.1</spotless.version>
        <palantir.version>2.84.0</palantir.version>
        <errorprone.version>2.50.0</errorprone.version>
        <japicmp.version>0.26.3</japicmp.version>
        <!-- The API compatibility report (quality profile) covers the modules that turn it on: chappe-api,
             chappe-http and chappe-core, each with the packages its module-info.java exports. -->
        <japicmp.skip>true</japicmp.skip>
        <sonar.projectKey>vidocq-chappe</sonar.projectKey>
        <sonar.java.source>25</sonar.java.source>
        <!--
            SonarQube calibration (Vidocq/vidocq#284). Every module reads the aggregated report of
            chappe-coverage, built by the quality profile: most tests live in chappe-tests and
            chappe-conformance, so a per-module report would hide what they cover.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/chappe-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- The examples have no tests of their own: analysed, but out of the coverage. -->
        <sonar.coverage.exclusions>**/chappe-examples/**</sonar.coverage.exclusions>
        <sonar.exclusions>**/generated/**</sonar.exclusions>
        <!-- Writing to the console (java:S106) is what the CLI and the examples are for. -->
        <sonar.issue.ignore.multicriteria>cli,examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.cli.ruleKey>java:S106</sonar.issue.ignore.multicriteria.cli.ruleKey>
        <sonar.issue.ignore.multicriteria.cli.resourceKey>**/chappe-cli/src/main/java/**</sonar.issue.ignore.multicriteria.cli.resourceKey>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/chappe-examples/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    </properties>

    <modules>
        <module>chappe-api</module>
        <module>chappe-http</module>
        <module>chappe-core</module>
        <module>chappe-tests</module>
        <module>chappe-bench</module>
        <module>chappe-conformance</module>
        <module>chappe-examples</module>
        <module>chappe-static-index-maven-plugin</module>
        <module>chappe-cli</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Inter-project dependencies -->
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <palantirJavaFormat>
                                <version>${palantir.version}</version>
                                <style>PALANTIR</style>
                            </palantirJavaFormat>
                            <removeUnusedImports/>
                            <importOrder>
                                <order>java,javax,jakarta,io.vidocq,</order>
                            </importOrder>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals><goal>check</goal></goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                Activated together with the quality profile of vidocq-parent (JaCoCo agent and
                per-module reports): adds the module that aggregates them for SonarQube.
            -->
            <id>quality</id>
            <modules>
                <module>chappe-coverage</module>
            </modules>
            <build>
                <plugins>
                    <!-- API compatibility with the last release (Vidocq/vidocq#288), report mode: japicmp
                         compares each jar with the latest x.y.z release on Maven Central and writes
                         target/japicmp/; nothing breaks the build until 1.0.0-RC1 makes it a gate. -->
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <parameter>
                                <oldVersionPattern>\d+\.\d+\.\d+</oldVersionPattern>
                                <onlyModified>true</onlyModified>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            </parameter>
                            <skipDiffReport>true</skipDiffReport>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-compatibility</id>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Error Prone (Vidocq/vidocq#269): run locally with -Perrorprone, and by the SonarQube job, which
             imports its warnings as external issues. Report mode, like the rest of the analysis: every
             finding is a warning (-XepAllErrorsAsWarnings), none stops the build. -->
        <profile>
            <id>errorprone</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <configuration>
                                <compilerArgs combine.children="append">
                                    <arg>-XDcompilePolicy=simple</arg>
                                    <arg>--should-stop=ifError=FLOW</arg>
                                    <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepExcludedPaths:.*(generated|generated-sources)/.* -XepDisableWarningsInGeneratedCode</arg>
                                    <!-- javac stops printing warnings after 100 per module by default: SonarQube
                                         would only import the first 100 findings of a module. -->
                                    <arg>-Xmaxwarns</arg>
                                    <arg>100000</arg>
                                </compilerArgs>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>com.google.errorprone</groupId>
                                        <artifactId>error_prone_core</artifactId>
                                        <version>${errorprone.version}</version>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
